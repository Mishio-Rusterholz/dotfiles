[org/gnome/desktop/background]
picture-options='zoom'
picture-uri='file://{{HOME}}/.config/background'
picture-uri-dark='file://{{HOME}}/.config/background'
primary-color='#000000000000'
secondary-color='#000000000000'

[org/gnome/desktop/interface]
accent-color='teal'
clock-show-seconds=true
clock-show-weekday=true
color-scheme='default'
font-name='Liberation Mono 11'
gtk-theme='Yaru-prussiangreen'
icon-theme='Yaru-prussiangreen'

[org/gnome/desktop/calendar]
week-start-day='monday'

[org/gnome/desktop/input-sources]
xkb-options=['grp:caps_toggle']

[org/gnome/desktop/privacy]
report-technical-problems=false

[org/gnome/shell]
favorite-apps=['org.gnome.Settings.desktop', 'org.gnome.Nautilus.desktop', 'com.mitchellh.ghostty.desktop', 'google-chrome.desktop', 'code.desktop', 'slack.desktop', 'org.qgis.qgis.desktop', 'org.cloudcompare.CloudCompare.desktop', 'discord.desktop', 'chrome-jkeipnhncidnkjhpeoiehafoaabagaha-Profile_1.desktop', 'chrome-fmpnliohjhemenmnlpbfagaolkdacoja-Default.desktop']

[org/gnome/shell/extensions/ding]
show-home=false

[org/gnome/desktop/wm/keybindings]
toggle-maximized=['<Super>Up']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']
terminal=@as []

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Control><Alt>t'
command='ghostty'
name='ghostty'

[org/gnome/shell/extensions/dash-to-dock]
dash-max-icon-size=36
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
multi-monitor=true

[org/gnome/Showtime/State]
is-maximized=false