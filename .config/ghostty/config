theme = Catppuccin Mocha
background-opacity = 0.75
background-blur-radius = 20
gtk-titlebar = false
keybind = ctrl+tab=goto_split:next
keybind = ctrl+shift+tab=goto_split:previous
keybind = ctrl+enter=ignore
keybind = ctrl+;=ignore
keybind = shift+enter=ignore
keybind = alt+super+h=resize_split:left,30
keybind = alt+super+j=resize_split:down,30
keybind = alt+super+k=resize_split:up,30
keybind = alt+super+l=resize_split:right,30
keybind = ctrl+backspace=text:
cursor-style = block
scrollback-limit = 104857600
window-height = 30
window-width = 105
window-position-x = 0
window-position-y = 0
window-padding-x = 0
window-padding-y = 0
font-size = 11
